      "margin": 0.03
    },
    {
      "fact": "face.forehead_share",
      "from": "forehead_share",
      "view": "frontal",
      "cuts": [{ "below": 0.88, "value": "shorter" }, { "below": 1.12, "value": "similar" }, { "value": "longer" }],
      "margin": 0.05,
      "requires": ["hairline_visible"]
    },
    {
      "fact": "face.lower_share",
      "from": "lower_share",
      "view": "frontal",
      "cuts": [{ "below": 0.88, "value": "shorter" }, { "below": 1.12, "value": "similar" }, { "value": "longer" }],
      "margin": 0.05,
      "requires": ["hairline_visible"]
    },
    {
      "fact": "face.jaw_vs_cheek",
