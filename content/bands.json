      "view": "frontal",
      "cuts": [{ "below": 0.8, "value": "narrower" }, { "below": 0.9, "value": "similar" }, { "value": "wider" }],
      "margin": 0.02
    },
    {
      "fact": "face.jaw_angle",
      "from": "jaw_angle",
