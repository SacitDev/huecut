    {
      "fact": "face.chin_width",
      "from": "chin_to_jaw",
      "view": "frontal",
      "cuts": [{ "below": 0.33, "value": "narrow" }, { "below": 0.43, "value": "similar" }, { "value": "broad" }],
      "margin": 0.02
    }
  ],
  "current_length_cm": {
    "very_short": [0, 6],
    "short": [6, 14],
    "chin": [14, 22],
    "shoulder": [22, 38],
    "long": [38, 60],
    "very_long": [60, 100]
