{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+-(front|side|back)$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "widthPx": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "heightPx": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "widths": {
        "minItems": 1,
        "type": "array",
        "items": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "average": {
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000000
      },
      "quality": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "widthPx",
      "heightPx",
      "widths",
      "average",
      "bytes"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    }
  }
}
