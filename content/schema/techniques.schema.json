{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "kind": {
        "type": "string",
        "const": "technique"
      },
      "name": {
        "$ref": "#/$defs/__schema0"
      },
      "category": {
        "type": "string",
        "enum": [
          "process",
          "placement",
          "finish",
          "blending",
          "coverage",
          "correction"
        ]
      },
      "how": {
        "$ref": "#/$defs/__schema0"
      },
      "regions": {
        "minItems": 1,
        "type": "array",
        "items": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "lightening": {
        "type": "string",
        "enum": [
          "none",
          "some",
          "always"
        ]
      },
      "lifts": {
        "type": "object",
        "properties": {
          "natural": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "coloured": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "required": [
          "natural",
          "coloured"
        ],
        "additionalProperties": false
      },
      "pairs_with": {
        "type": "object",
        "properties": {
          "families": {
            "$ref": "#/$defs/__schema2"
          },
          "avoid": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": [
          "families",
          "avoid"
        ],
        "additionalProperties": false
      },
      "regrowth_friendliness": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "revisit_weeks": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "#/$defs/__schema3"
          },
          {
            "$ref": "#/$defs/__schema4"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "session_hours": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "#/$defs/__schema5"
          },
          {
            "$ref": "#/$defs/__schema6"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "damage_risk": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "salon_only": {
        "type": "boolean"
      },
      "client": {
        "$ref": "#/$defs/__schema0"
      },
      "stylist": {
        "$ref": "#/$defs/__schema0"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "supports": {
              "$ref": "#/$defs/__schema0"
            },
            "level": {
              "type": "string",
              "enum": [
                "authority",
                "research",
                "trade_consensus",
                "single_source",
                "design_logic",
                "policy"
              ]
            }
          },
          "required": [
            "url",
            "supports",
            "level"
          ],
          "additionalProperties": false
        }
      },
      "evidence": {
        "type": "string",
        "enum": [
          "authority",
          "research",
          "trade_consensus",
          "single_source",
          "design_logic",
          "policy"
        ]
      },
      "review": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "checked"
            ]
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "note": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "status",
          "date"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "kind",
      "name",
      "category",
      "how",
      "regions",
      "lightening",
      "lifts",
      "pairs_with",
      "regrowth_friendliness",
      "revisit_weeks",
      "session_hours",
      "damage_risk",
      "salon_only",
      "client",
      "stylist",
      "sources",
      "evidence",
      "review"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "root",
        "mids",
        "ends",
        "face_frame",
        "highlights",
        "lowlights"
      ]
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "blonde",
          "brunette",
          "red_copper",
          "black",
          "grey_silver",
          "vivid"
        ]
      }
    },
    "__schema3": {
      "type": "number",
      "minimum": 1,
      "maximum": 26
    },
    "__schema4": {
      "type": "number",
      "minimum": 1,
      "maximum": 26
    },
    "__schema5": {
      "type": "number",
      "minimum": 0,
      "maximum": 12
    },
    "__schema6": {
      "type": "number",
      "minimum": 0,
      "maximum": 12
    }
  }
}
